# ========================================
# AI游戏工坊 - 环境变量配置
# ========================================

# DeepSeek API 配置（推荐使用）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI API 配置（可选）
# OPENAI_API_KEY=sk-your-openai-api-key

# 服务器端口（本地开发用）
PORT=80

# ========================================
# 管理员配置
# ========================================

# 管理员密钥（用于访问管理后台和管理API）
# 建议设置一个复杂的随机字符串（至少32位）
# 可使用: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=Qqwbq3958

# 微信公众号关注验证码
# 用户关注公众号后，输入此验证码可领取积分
WECHAT_VERIFY_CODE=2026

# ========================================
# 微信小程序配置（用于登录和订阅消息推送）
# ========================================

# 小程序AppID（必填，在微信公众平台获取）
WX_APPID=your-mini-program-appid

# 小程序AppSecret（必填，在微信公众平台获取）
WX_APPSECRET=your-mini-program-appsecret

# 订阅消息模板ID - 游戏创建完成通知（必填，用于通知用户游戏生成完成）
# 获取方式：
# 1. 登录微信公众平台 (https://mp.weixin.qq.com)
# 2. 进入 订阅消息 -> 公共模板库
# 3. 搜索"任务完成"或类似模板
# 4. 选用模板并获取模板ID
# 
# 模板字段要求（代码中使用的字段）：
# - thing1: 任务名称（游戏名称）
# - phrase2: 任务状态（如"已完成"）
# - time3: 完成时间
# - thing4: 备注（如"点击查看你的游戏"）
# 
# 注意：如果你选用的模板字段名不同，需要修改 api/_lib/wechat.js 中的 data 字段映射
WX_SUBSCRIBE_TMPL_GAME_CREATED=your-subscribe-template-id

# ========================================
# 安全配置
# ========================================

# 运行环境：development 或 production
# 生产环境会启用更严格的安全策略（HSTS、严格CORS等）
NODE_ENV=development

# 允许的CORS来源（生产环境使用，逗号分隔）
# 例如: https://yijuhuayouxi.com,https://www.yijuhuayouxi.com
ALLOWED_ORIGINS=*

# ========================================
# Vercel KV 配置（部署到 Vercel 时需要）
# 这些变量在连接 Vercel KV 数据库后会自动填充
# ========================================
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
