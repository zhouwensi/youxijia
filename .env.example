# ========================================
# AI游戏工坊 - 环境变量配置
# ========================================

# DeepSeek API 配置（推荐使用）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI API 配置（可选）
# OPENAI_API_KEY=sk-your-openai-api-key

# 服务器端口（本地开发用）
PORT=80

# ========================================
# 管理员配置
# ========================================

# 管理员密钥（用于访问管理后台和管理API）
# 建议设置一个复杂的随机字符串（至少32位）
# 可使用: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=Qqwbq3958

# 微信公众号关注验证码
# 用户关注公众号后，输入此验证码可领取积分
WECHAT_VERIFY_CODE=2026

# ========================================
# 安全配置
# ========================================

# 运行环境：development 或 production
# 生产环境会启用更严格的安全策略（HSTS、严格CORS等）
NODE_ENV=development

# 允许的CORS来源（生产环境使用，逗号分隔）
# 例如: https://yijuhuayouxi.com,https://www.yijuhuayouxi.com
ALLOWED_ORIGINS=*

# ========================================
# Vercel KV 配置（部署到 Vercel 时需要）
# 这些变量在连接 Vercel KV 数据库后会自动填充
# ========================================
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
