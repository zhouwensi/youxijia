.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: linear-gradient(to top, #1a1a2e 0%, #1a1a2e 90%, rgba(26, 26, 46, 0.95) 100%);
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  transition: all 0.2s ease;
}

.tab-bar-item.active {
  transform: scale(1.05);
}

.tab-icon {
  font-size: 44rpx;
  height: 50rpx;
  line-height: 50rpx;
  margin-bottom: 4rpx;
  transition: transform 0.2s ease;
}

.tab-bar-item.active .tab-icon {
  transform: scale(1.1);
}

.tab-text {
  font-size: 22rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.tab-bar-item.active .tab-text {
  font-weight: 600;
}