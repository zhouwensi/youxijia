<view class="page">
  <view wx:if="{{mode === 'bindEmail'}}">
    <view wx:if="{{alreadyBound}}" class="hint" style="margin-bottom: 24rpx;">
      <view>已绑定邮箱：<text style="color:#00d4ff;">{{boundEmail}}</text></view>
      <view>与网站使用同一账号，积分与作品自动同步。</view>
    </view>
    <block wx:else>
      <view class="label">邮箱（与网站登录一致）</view>
      <input class="input form-group" type="text" placeholder="your@email.com" value="{{bindEmail}}" bindinput="onBindEmail" />
      <view class="label">密码（至少 8 位，网站登录用同一密码）</view>
      <input class="input form-group" type="password" password="{{true}}" value="{{bindPassword}}" bindinput="onBindPassword" />
      <view class="label">确认密码</view>
      <input class="input form-group" type="password" password="{{true}}" value="{{bindPassword2}}" bindinput="onBindPassword2" />
      <view class="error" wx:if="{{error}}">{{error}}</view>
      <button class="btn-primary" loading="{{loading}}" bindtap="submitBindEmail">绑定并同步网站</button>
    </block>
    <view class="hint">绑定后：网站用该邮箱+密码登录，与小程序为同一用户（同一积分、作品）。领取/兑换积分仍在小程序完成。</view>
  </view>

  <view wx:elif="{{mode === 'changepwd'}}">
    <view wx:if="{{firstTimePassword}}" class="hint" style="margin-bottom: 24rpx;">
      您当前为<strong>微信登录</strong>账号。设置密码后，可在<strong>电脑浏览器打开网站</strong>，用「账号 ID 或已绑邮箱 + 此密码」登录<strong>同一账号</strong>（积分与作品同步）。
    </view>
    <block wx:if="{{!firstTimePassword}}">
      <view class="label">当前密码</view>
      <input class="input form-group" type="password" password="{{true}}" placeholder="原密码" value="{{oldPassword}}" bindinput="onOldPwd" />
    </block>
    <view class="label">{{firstTimePassword ? '登录密码（至少 8 位）' : '新密码（至少 8 位）'}}</view>
    <input class="input form-group" type="password" password="{{true}}" placeholder="{{firstTimePassword ? '设置网站登录密码' : '新密码'}}" value="{{newPassword}}" bindinput="onNewPwd" />
    <view class="label">确认密码</view>
    <input class="input form-group" type="password" password="{{true}}" placeholder="再次输入" value="{{newPassword2}}" bindinput="onNewPwd2" />
    <view class="error" wx:if="{{error}}">{{error}}</view>
    <button wx:if="{{firstTimePassword}}" class="btn-primary" loading="{{loading}}" bindtap="submitFirstPassword">保存密码</button>
    <button wx:else class="btn-primary" loading="{{loading}}" bindtap="submitChangePwd">保存新密码</button>
    <view class="hint" wx:if="{{firstTimePassword}}">也可在「我的 → 绑定邮箱」同时绑定邮箱，网站侧可用邮箱登录。</view>
    <view class="hint" wx:else>忘记密码且无法登录时，请使用邮箱重新注册或联系管理员。</view>
  </view>

  <view wx:else>
    <view class="tabs">
      <view class="tab {{authTab === 'login' ? 'active' : ''}}" data-tab="login" bindtap="switchTab">登录</view>
      <view class="tab {{authTab === 'register' ? 'active' : ''}}" data-tab="register" bindtap="switchTab">注册</view>
    </view>

    <block wx:if="{{authTab === 'login'}}">
      <view class="label">邮箱 / 账号 ID / 昵称</view>
      <input class="input form-group" placeholder="注册邮箱或账号 ID" value="{{loginAccount}}" bindinput="onLoginAccount" />
      <view class="label">密码</view>
      <input class="input form-group" type="password" password="{{true}}" placeholder="密码" value="{{loginPassword}}" bindinput="onLoginPassword" />
      <view class="error" wx:if="{{error}}">{{error}}</view>
      <button class="btn-primary" loading="{{loading}}" bindtap="submitLogin">登录</button>
      <button class="btn-secondary" bindtap="wxLoginOnly">仅微信登录（未绑邮箱时与网站不同步）</button>
    </block>

    <block wx:else>
      <view class="label">邮箱</view>
      <input class="input form-group" type="text" placeholder="your@email.com" value="{{regEmail}}" bindinput="onRegEmail" />
      <view class="label">密码（至少 8 位）</view>
      <input class="input form-group" type="password" password="{{true}}" value="{{regPassword}}" bindinput="onRegPassword" />
      <view class="label">确认密码</view>
      <input class="input form-group" type="password" password="{{true}}" value="{{regPassword2}}" bindinput="onRegPassword2" />
      <view class="label">昵称（可选）</view>
      <input class="input form-group" placeholder="展示名" maxlength="20" value="{{regNickname}}" bindinput="onRegNickname" />
      <view class="error" wx:if="{{error}}">{{error}}</view>
      <button class="btn-primary" loading="{{loading}}" bindtap="submitRegister">注册并登录</button>
    </block>

    <view class="hint">💎 与网站一致：请用「邮箱登录」或「注册」；若已用微信登录，请到「我的 → 绑定邮箱」后再到网站用邮箱登录。</view>
    <view class="hint">领取与兑换积分仅在小程序「积分」页完成；积分与作品在网站与小程序共用同一账号。</view>
  </view>
</view>
