.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: #0f0f1a;
}

.tabs {
  display: flex;
  margin-bottom: 40rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  color: #8b8b8b;
  font-size: 30rpx;
}

.tab.active {
  color: #00d4ff;
  font-weight: 600;
  border-bottom: 4rpx solid #00d4ff;
}

.form-group {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  color: rgba(255, 255, 255, 0.65);
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  padding: 24rpx;
  background: #1a1a2e;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
}

.hint {
  color: rgba(255, 255, 255, 0.45);
  font-size: 22rpx;
  line-height: 1.5;
  margin-top: 24rpx;
}

.btn-primary {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 28rpx;
  font-size: 30rpx;
}

.btn-secondary {
  margin-top: 24rpx;
  background: transparent;
  color: #00d4ff;
  border: 1rpx solid rgba(0, 212, 255, 0.4);
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
}

.error {
  color: #f87171;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}
