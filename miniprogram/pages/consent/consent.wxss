.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0a0a10;
  color: #fff;
  box-sizing: border-box;
}
.hero {
  padding: 48rpx 32rpx 24rpx;
}
.title {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
}
.sub {
  font-size: 26rpx;
  color: #9aa0b4;
  display: block;
}
.scroll {
  width: 100%;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.card {
  background: #161622;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1px solid #2a2a3d;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 16rpx;
}
.p {
  font-size: 26rpx;
  color: #c8cdda;
  line-height: 1.6;
}
.links {
  margin-bottom: 24rpx;
}
.link-row {
  padding: 20rpx 0;
  color: #5ed0ff;
  font-size: 28rpx;
  border-bottom: 1px solid #222336;
}
.check-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  color: #dfe4f2;
  padding-bottom: 120rpx;
}
.footer {
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(10, 10, 16, 0.96);
  border-top: 1px solid #222336;
}
.btn.primary {
  background: linear-gradient(135deg, #00b4db, #0083b0);
  color: #fff;
  border-radius: 14rpx;
  font-size: 30rpx;
}
