<!--创作引导页 - 引导用户去网站创作，小程序端领取积分-->
<view class="page-container">
  <view class="header">
    <view class="header-left">
      <text class="logo-icon">🎮</text>
      <text class="logo-text">{{appName}}</text>
    </view>
    <view class="header-right">
      <view class="search-btn" bindtap="goToSearch">
        <text class="search-icon">🔍</text>
      </view>
    </view>
  </view>

  <scroll-view class="main-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="credits-section">
      <view class="credits-card" bindtap="goToCredits">
        <view class="credits-main">
          <view class="credits-info">
            <text class="credits-label">我的积分</text>
            <text class="credits-value">{{credits}}</text>
          </view>
          <view class="credits-arrow">
            <text>查看详情 ></text>
          </view>
        </view>
        <view class="claimable-tip" wx:if="{{claimableCount > 0}}">
          <text class="tip-icon">🎁</text>
          <text class="tip-text">有{{claimableCount}}个奖励可领取，共{{claimableCredits}}积分</text>
        </view>
      </view>
    </view>

    <!-- 签到区域（按文档6.2节优化设计） -->
    <view class="checkin-section">
      <view class="checkin-card" bindtap="handleCheckin">
        <view class="checkin-left">
          <text class="checkin-icon">{{checkinStatus.checkedInToday ? '✅' : '📅'}}</text>
          <view class="checkin-info">
            <text class="checkin-title">{{checkinStatus.checkedInToday ? '今日已签到' : '每日签到'}}</text>
            <text class="checkin-desc" wx:if="{{!checkinStatus.checkedInToday}}">
              签到可得1积分{{checkinStatus.streakDays >= 2 ? '，已连续' + checkinStatus.streakDays + '天' : ''}}
            </text>
            <text class="checkin-desc" wx:else>
              已连续签到{{checkinStatus.streakDays}}天，保持记录！
            </text>
          </view>
        </view>
        <view class="checkin-btn {{checkinStatus.checkedInToday ? 'success' : ''}}">
          <text>{{checkinStatus.checkedInToday ? '+1 ✓' : '签到 +1'}}</text>
        </view>
      </view>
    </view>

    <view class="create-guide-section">
      <view class="guide-card">
        <view class="guide-header">
          <text class="guide-icon">✨</text>
          <text class="guide-title">去网站创作游戏</text>
        </view>
        <view class="guide-content">
          <text class="guide-desc">在网站上使用AI一句话生成游戏，创作完成后回来领取积分奖励</text>
          <view class="guide-steps">
            <view class="step-item"><text class="step-num">1</text><text class="step-text">复制网站链接</text></view>
            <view class="step-item"><text class="step-num">2</text><text class="step-text">浏览器打开创作</text></view>
            <view class="step-item"><text class="step-num">3</text><text class="step-text">回小程序领积分</text></view>
          </view>
        </view>
        <view class="guide-actions">
          <button class="primary-btn" bindtap="goToWebCreate">🌐 去网站创作</button>
          <view class="url-copy" bindtap="copyWebUrl">
            <text class="url-text">{{webUrl}}</text>
            <text class="copy-icon">📋</text>
          </view>
        </view>
      </view>
    </view>

    <view class="quick-entry-section">
      <view class="entry-item" bindtap="goToCredits">
        <text class="entry-icon">🏆</text>
        <text class="entry-text">领成就</text>
        <view class="entry-badge" wx:if="{{claimableCount > 0}}">{{claimableCount}}</view>
      </view>
      <view class="entry-item" bindtap="goToWorksPage">
        <text class="entry-icon">🎮</text>
        <text class="entry-text">作品广场</text>
      </view>
      <button class="entry-item entry-share-btn" open-type="share">
        <text class="entry-icon">📤</text>
        <text class="entry-text">分享好友</text>
      </button>
    </view>

    <view class="my-works-section">
      <view class="section-header">
        <view class="section-title">
          <text class="title-icon">🆕</text>
          <text>最新作品</text>
        </view>
        <view class="section-more" bindtap="goToWorksPage" wx:if="{{latestGames.length > 0}}">
          <text>更多</text>
          <text class="arrow">→</text>
        </view>
      </view>
      <view class="my-games-grid" wx:if="{{latestGames.length > 0}}">
        <view class="my-game-card" wx:for="{{latestGames}}" wx:key="id" data-game="{{item}}" bindtap="goToGameDetail">
          <view class="my-game-cover"><text class="my-game-emoji">{{item.emoji || '🎮'}}</text></view>
          <view class="my-game-info">
            <text class="my-game-title ellipsis">{{item.title || '未命名'}}</text>
            <view class="my-game-author"><text class="author-text">👤 {{item.author_name || '匿名'}}</text></view>
            <view class="my-game-stats">
              <text class="stat-item">❤️ {{item.likes || 0}}</text>
              <text class="stat-item">👁️ {{item.plays || 0}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="loading-more" wx:if="{{loadingLatestGames}}">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>
      <view class="empty-state" wx:if="{{!loadingLatestGames && latestGames.length === 0}}">
        <text class="empty-icon">🎮</text>
        <text class="empty-text">暂无作品，快去网站创作吧！</text>
      </view>
    </view>

    <view class="safe-area-bottom"></view>
  </scroll-view>
</view>
