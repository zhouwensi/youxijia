/**
 * 创作引导页样式 - 引导用户去网站创作，小程序端领取积分
 */

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f0f1a 0%, #1a1a2e 100%);
  display: flex;
  flex-direction: column;
}

/* 顶部标题栏 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: rgba(0, 0, 0, 0.3);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.logo-icon {
  font-size: 40rpx;
}

.logo-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.header-right {
  display: flex;
  align-items: center;
}

.search-btn {
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.search-icon {
  font-size: 32rpx;
}

/* 主滚动区 */
.main-scroll {
  flex: 1;
  height: calc(100vh - 100rpx);
}

/* 积分卡片区域 */
.credits-section {
  padding: 24rpx 32rpx;
}

.credits-card {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.3), rgba(118, 75, 162, 0.3));
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.credits-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.credits-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.credits-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.credits-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
}

.credits-arrow {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

.claimable-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.tip-icon {
  font-size: 28rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #ffd700;
}

/* 签到区域 */
.checkin-section {
  padding: 0 32rpx 24rpx;
}

.checkin-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.checkin-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.checkin-icon {
  font-size: 40rpx;
}

.checkin-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.checkin-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

.checkin-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.checkin-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #00d4ff 0%, #7b2cbf 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 32rpx;
}

.checkin-btn.disabled {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.5);
}

/* 签到成功状态（文档6.2节设计） */
.checkin-btn.success {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #fff;
}

/* 创作引导区域 */
.create-guide-section {
  padding: 0 32rpx 24rpx;
}

.guide-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.guide-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.guide-icon {
  font-size: 36rpx;
}

.guide-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.guide-content {
  margin-bottom: 24rpx;
}

.guide-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
  display: block;
  margin-bottom: 20rpx;
}

.guide-steps {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.step-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #00d4ff 0%, #7b2cbf 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 50%;
}

.step-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
}

.guide-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.primary-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  background: linear-gradient(135deg, #00d4ff 0%, #7b2cbf 100%);
  border-radius: 44rpx;
  border: none;
}

.primary-btn::after {
  border: none;
}

.url-copy {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 12rpx;
}

.url-text {
  font-size: 24rpx;
  color: #00d4ff;
}

.copy-icon {
  font-size: 24rpx;
}

/* 快捷入口 */
.quick-entry-section {
  display: flex;
  justify-content: space-around;
  padding: 0 32rpx 24rpx;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 32rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  position: relative;
  min-width: 160rpx;
}

.entry-icon {
  font-size: 40rpx;
}

.entry-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.entry-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: #ff4757;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 最新作品区域 */
.my-works-section {
  padding: 24rpx 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
}

.title-icon {
  font-size: 28rpx;
}

.section-more {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

.section-more .arrow {
  color: #00d4ff;
}

/* 游戏网格 */
.my-games-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.my-game-card {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  overflow: hidden;
  transition: all 0.2s;
}

.my-game-card:active {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.1);
}

.my-game-cover {
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(139, 92, 246, 0.2));
}

.my-game-emoji {
  font-size: 56rpx;
}

.my-game-info {
  padding: 16rpx;
}

.my-game-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #fff;
  display: block;
  margin-bottom: 4rpx;
}

.my-game-author {
  margin-bottom: 4rpx;
}

.my-game-author .author-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

.my-game-stats {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.stat-item {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* 文本省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 加载状态 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  gap: 16rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(0, 212, 255, 0.3);
  border-top-color: #00d4ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #8b8b8b;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8b8b8b;
}

/* 底部安全区 */
.safe-area-bottom {
  height: calc(env(safe-area-inset-bottom) + 120rpx);
}