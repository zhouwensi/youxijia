<!--
  游戏详情页 - 增强版
-->
<view class="page-container">
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 游戏内容 -->
  <scroll-view class="main-scroll" scroll-y wx:if="{{!loading && game}}">
    <!-- 游戏卡片 -->
    <view class="game-card">
      <!-- 游戏图标 -->
      <view class="game-cover">
        <text class="game-emoji">🎮</text>
      </view>
      
      <!-- 游戏标题 -->
      <view class="game-title">{{game.title || '未命名游戏'}}</view>
      
      <!-- 游戏描述 -->
      <view class="game-prompt">{{game.prompt || '暂无描述'}}</view>
      
      <!-- 统计数据 -->
      <view class="game-stats">
        <view class="stat-item">
          <text class="stat-icon">👁️</text>
          <text class="stat-value">{{viewCount}}</text>
          <text class="stat-label">查看</text>
        </view>
        <view class="stat-item">
          <text class="stat-icon">❤️</text>
          <text class="stat-value">{{likeCount}}</text>
          <text class="stat-label">点赞</text>
        </view>
        <!-- 评论统计：评论功能禁用时隐藏 -->
        <view class="stat-item" wx:if="{{!commentDisabled}}">
          <text class="stat-icon">💬</text>
          <text class="stat-value">{{commentCount}}</text>
          <text class="stat-label">评论</text>
        </view>
      </view>
    </view>

    <!-- 作者信息卡片 -->
    <view class="author-card">
      <view class="author-left" bindtap="viewAuthor">
        <view class="author-avatar">
          <text>{{game.author_avatar || '👤'}}</text>
        </view>
        <view class="author-info">
          <view class="author-name">{{game.author_name || '匿名'}}</view>
          <view class="author-meta">🎮 {{game.author_games_count || 0}} 作品</view>
        </view>
      </view>
      <!-- 不是自己的游戏时才显示关注按钮 -->
      <view 
        class="follow-btn {{authorFollowed ? 'followed' : ''}} {{followingAuthor ? 'loading' : ''}}"
        bindtap="handleFollowAuthor"
        wx:if="{{!isSelfGame}}"
      >
        <text wx:if="{{authorFollowed}}">✓ 已关注</text>
        <text wx:else>+ 关注</text>
      </view>
      <!-- 是自己的游戏时显示"我的"标识 -->
      <view class="owner-badge" wx:if="{{isSelfGame}}">
        <text>👤 我的</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar">
      <view class="action-btn {{liked ? 'active' : ''}}" bindtap="handleLike">
        <text class="action-icon">{{liked ? '❤️' : '🤍'}}</text>
        <text class="action-text">{{liked ? '已赞' : '点赞'}}</text>
      </view>
      <view class="action-btn {{favorited ? 'active' : ''}}" bindtap="handleFavorite">
        <text class="action-icon">{{favorited ? '⭐' : '☆'}}</text>
        <text class="action-text">{{favorited ? '已收藏' : '收藏'}}</text>
      </view>
      <button class="action-btn share-btn-native" open-type="share">
        <text class="action-icon">📤</text>
        <text class="action-text">分享</text>
      </button>
    </view>

    <!-- 作者操作按钮 (仅作者可见) -->
    <view class="owner-actions" wx:if="{{isOwner}}">
      <view class="owner-action-btn repair-btn {{repairing ? 'loading' : ''}}" bindtap="handleRepair">
        <text class="owner-action-icon">🔧</text>
        <text class="owner-action-text">{{repairing ? '修复中...' : 'AI修复'}}</text>
      </view>
      <view class="owner-action-btn edit-btn" bindtap="handleEdit">
        <text class="owner-action-icon">✏️</text>
        <text class="owner-action-text">编辑</text>
      </view>
    </view>

    <!-- 评论区：评论功能禁用时完全隐藏 -->
    <view class="comments-section" wx:if="{{!commentDisabled}}">
      <view class="section-header">
        <text class="section-title">💬 评论</text>
        <text class="section-count">{{comments.length}}条</text>
      </view>

      <!-- 评论输入框 -->
      <view class="comment-input-box">
        <input 
          class="comment-input" 
          type="text"
          value="{{commentText}}"
          bindinput="onCommentInput"
          placeholder="说点什么..."
          maxlength="500"
          confirm-type="send"
          bindconfirm="submitComment"
        />
        <view class="comment-submit-btn {{submittingComment ? 'loading' : ''}}" bindtap="submitComment">
          <text>{{submittingComment ? '...' : '发送'}}</text>
        </view>
      </view>
      
      <!-- 评论列表 -->
      <view class="comments-list" wx:if="{{comments.length > 0}}">
        <view class="comment-item" wx:for="{{comments}}" wx:key="id">
          <view class="comment-avatar">
            <text>{{item.user_avatar || '👤'}}</text>
          </view>
          <view class="comment-content">
            <view class="comment-header">
              <text class="comment-author">{{item.user_name || '匿名'}}</text>
              <text class="comment-time">{{item.created_at}}</text>
            </view>
            <view class="comment-text">{{item.content}}</view>
          </view>
        </view>
      </view>
      
      <!-- 无评论 -->
      <view class="no-comments" wx:else>
        <text class="no-comments-icon">💬</text>
        <text class="no-comments-text">暂无评论，快来抢沙发吧！</text>
      </view>
    </view>

    <!-- 提示 -->
    <view class="tip-card">
      <text class="tip-icon">💡</text>
      <text class="tip-text">小程序暂不支持直接游玩，请点击下方按钮在浏览器中打开</text>
    </view>

    <!-- 底部安全区占位 -->
    <view class="bottom-placeholder"></view>
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar" wx:if="{{!loading && game}}">
    <view class="play-btn" bindtap="playGame">
      <text class="play-icon">🎮</text>
      <text class="play-text">去网页玩游戏</text>
    </view>
  </view>
</view>