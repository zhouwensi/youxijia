/**
 * 游戏详情页样式
 */

.page-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding: 20rpx;
  padding-bottom: 160rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

.loading-text {
  color: var(--text-secondary);
  font-size: 28rpx;
}

/* 游戏卡片 */
.game-card {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border-color);
  text-align: center;
}

.game-cover {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 24rpx;
  background: linear-gradient(135deg, #2d2d4a, #1a1a2e);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.3);
}

.game-emoji {
  font-size: 80rpx;
}

.game-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 16rpx;
}

.game-prompt {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

/* 作者信息 */
.author-info {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.author-avatar {
  width: 60rpx;
  height: 60rpx;
  background-color: var(--bg-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
}

.author-name {
  font-size: 28rpx;
  color: var(--primary-color);
}

.author-arrow {
  font-size: 28rpx;
  color: var(--text-muted);
  margin-left: 8rpx;
}

/* 统计数据 */
.game-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border-color);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 操作栏 */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background-color: var(--bg-card);
  border-radius: 16rpx;
  border: 1rpx solid var(--border-color);
  transition: all 0.3s;
}

.action-btn.active {
  background-color: rgba(0, 212, 255, 0.1);
  border-color: var(--primary-color);
}

.action-btn:active {
  transform: scale(0.95);
}

.share-btn-native {
  background-color: var(--bg-card);
  line-height: normal;
  font-size: inherit;
}

.share-btn-native::after {
  border: none;
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.action-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.action-btn.active .action-text {
  color: var(--primary-color);
}

/* 评论区 */
.comments-section {
  background-color: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border-color);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
}

.section-count {
  font-size: 24rpx;
  color: var(--text-muted);
}

.comments-list {
  
}

.comment-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  background-color: var(--bg-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.comment-content {
  flex: 1;
}

.comment-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.comment-author {
  font-size: 26rpx;
  color: var(--text-color);
  font-weight: 500;
}

.comment-time {
  font-size: 22rpx;
  color: var(--text-muted);
}

.comment-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 无评论 */
.no-comments {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.no-comments-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.no-comments-text {
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 提示卡片 */
.tip-card {
  display: flex;
  align-items: center;
  background-color: rgba(255, 170, 0, 0.1);
  border: 1rpx solid rgba(255, 170, 0, 0.3);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.tip-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.tip-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--warning-color);
  line-height: 1.5;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: linear-gradient(to top, var(--bg-color) 60%, transparent);
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.play-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  color: #000000;
  padding: 28rpx 40rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 30rpx rgba(0, 212, 255, 0.3);
}

.play-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.play-icon {
  margin-right: 12rpx;
  font-size: 36rpx;
}

.play-text {
  font-weight: 600;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
