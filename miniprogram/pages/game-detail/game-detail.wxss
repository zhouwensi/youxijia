/**
 * 游戏详情页样式 - 增强版
 */

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f0f1a 0%, #1a1a2e 100%);
  display: flex;
  flex-direction: column;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(0, 212, 255, 0.3);
  border-top-color: #00d4ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

.loading-text {
  color: #8b8b8b;
  font-size: 28rpx;
}

/* 主滚动区 */
.main-scroll {
  flex: 1;
  height: calc(100vh - 140rpx);
}

/* 游戏卡片 */
.game-card {
  background: rgba(255, 255, 255, 0.05);
  margin: 24rpx 32rpx;
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
}

.game-cover {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 24rpx;
  background: linear-gradient(135deg, #2d2d4a, #1a1a2e);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.3);
}

.game-emoji {
  font-size: 80rpx;
}

.game-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 16rpx;
}

.game-prompt {
  font-size: 28rpx;
  color: #8b8b8b;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

/* 作者卡片 */
.author-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.05);
  margin: 0 32rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.author-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #7b2cbf 0%, #00d4ff 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
}

.author-info {
  flex: 1;
}

.author-name {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.author-meta {
  font-size: 24rpx;
  color: #8b8b8b;
}

.follow-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #00d4ff 0%, #7b2cbf 100%);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

.follow-btn.followed {
  background: rgba(255, 255, 255, 0.1);
  color: #8b8b8b;
}

.follow-btn.loading {
  opacity: 0.6;
}

/* 统计数据 */
.game-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.stat-label {
  font-size: 22rpx;
  color: #666;
}

/* 操作栏 */
.action-bar {
  display: flex;
  gap: 16rpx;
  margin: 0 32rpx 24rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  border: none;
  transition: all 0.3s;
}

.action-btn.active {
  background: rgba(0, 212, 255, 0.15);
}

.action-btn:active {
  transform: scale(0.95);
}

.share-btn-native {
  background: rgba(255, 255, 255, 0.05);
  line-height: normal;
  font-size: inherit;
  padding: 24rpx;
}

.share-btn-native::after {
  border: none;
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.action-text {
  font-size: 24rpx;
  color: #8b8b8b;
}

.action-btn.active .action-text {
  color: #00d4ff;
}

/* 评论区 */
.comments-section {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 32rpx 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

.section-count {
  font-size: 24rpx;
  color: #666;
}

.comment-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #7b2cbf 0%, #00d4ff 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.comment-content {
  flex: 1;
}

.comment-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.comment-author {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

.comment-time {
  font-size: 22rpx;
  color: #666;
}

.comment-text {
  font-size: 28rpx;
  color: #8b8b8b;
  line-height: 1.5;
}

/* 无评论 */
.no-comments {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.no-comments-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.no-comments-text {
  font-size: 26rpx;
  color: #666;
}

/* 提示卡片 */
.tip-card {
  display: flex;
  align-items: center;
  background: rgba(255, 170, 0, 0.1);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin: 0 32rpx 24rpx;
}

.tip-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #ffaa00;
  line-height: 1.5;
}

/* 底部占位 */
.bottom-placeholder {
  height: 140rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  background: linear-gradient(to top, #0f0f1a 60%, transparent);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.play-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #00d4ff 0%, #7b2cbf 100%);
  color: #fff;
  padding: 28rpx 40rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 30rpx rgba(0, 212, 255, 0.3);
}

.play-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.play-icon {
  margin-right: 12rpx;
  font-size: 36rpx;
}

.play-text {
  font-weight: 600;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
