/**
 * 游戏编辑页面样式 - 对话式界面
 */

/* 容器 */
.chat-container {
  height: 100vh;
  background: linear-gradient(180deg, #0f0f1a 0%, #1a1a2e 100%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chat-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(0, 212, 255, 0.3);
  border-top-color: #00d4ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

.loading-text {
  color: #8b8b8b;
  font-size: 28rpx;
}

/* 顶部游戏信息栏 */
.game-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: rgba(255, 255, 255, 0.05);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.game-info {
  display: flex;
  align-items: center;
  flex: 1;
  overflow: hidden;
}

.game-emoji-box {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.2) 0%, rgba(138, 43, 226, 0.2) 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.game-emoji {
  font-size: 40rpx;
}

.game-meta {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  flex: 1;
}

.game-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 320rpx;
}

.game-status {
  font-size: 24rpx;
  color: #8b8b8b;
  margin-top: 6rpx;
}

.header-actions {
  display: flex;
  gap: 20rpx;
  flex-shrink: 0;
}

/* 操作按钮 - 使用view替代button避免默认样式 */
.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
}

.action-btn-hover {
  opacity: 0.7;
  transform: scale(0.95);
}

.action-btn-danger {
  background: rgba(255, 68, 68, 0.15);
}

.action-icon {
  font-size: 32rpx;
  line-height: 1;
}

.action-text {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.action-btn-danger .action-text {
  color: #ff6b6b;
}

/* 对话消息区域 */
.chat-messages {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

/* 消息样式 */
.message {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.message-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.message-content {
  max-width: 75%;
  display: flex;
  flex-direction: column;
}

.message-bubble {
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
  white-space: pre-wrap;
}

.message-time {
  font-size: 20rpx;
  color: #666;
  margin-top: 8rpx;
}

/* 用户消息 - 右对齐蓝色 */
.message-user {
  flex-direction: row-reverse;
}

.message-user .message-avatar {
  margin-left: 16rpx;
}

.message-user .message-content {
  align-items: flex-end;
}

.message-user .message-bubble {
  background: linear-gradient(135deg, #00d4ff 0%, #0099cc 100%);
  color: #fff;
  border-bottom-right-radius: 8rpx;
}

/* AI消息 - 左对齐灰色 */
.message-ai {
  flex-direction: row;
}

.message-ai .message-avatar {
  margin-right: 16rpx;
  background: linear-gradient(135deg, #8a2be2 0%, #5c1a99 100%);
}

.message-ai .message-content {
  align-items: flex-start;
}

.message-ai .message-bubble {
  background: rgba(255, 255, 255, 0.1);
  color: #e0e0e0;
  border-bottom-left-radius: 8rpx;
}

/* 加载中状态 */
.message-bubble.loading {
  background: rgba(138, 43, 226, 0.2);
  border: 1rpx solid rgba(138, 43, 226, 0.3);
}

/* 错误状态 */
.message-bubble.error {
  background: rgba(255, 68, 68, 0.15);
  border: 1rpx solid rgba(255, 68, 68, 0.3);
  color: #ff6b6b;
}

/* 打字指示器 */
.typing-indicator {
  display: flex;
  gap: 8rpx;
  padding: 8rpx 0 0 0;
}

.typing-indicator .dot {
  width: 12rpx;
  height: 12rpx;
  background: #8a2be2;
  border-radius: 50%;
  animation: typing 1.4s infinite ease-in-out both;
}

.typing-indicator .dot:nth-child(1) {
  animation-delay: -0.32s;
}

.typing-indicator .dot:nth-child(2) {
  animation-delay: -0.16s;
}

.typing-indicator .dot:nth-child(3) {
  animation-delay: 0s;
}

@keyframes typing {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 消息操作 */
.message-actions {
  margin-top: 12rpx;
}

.btn-retry {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #fff;
}

.btn-retry:active {
  opacity: 0.7;
}

/* 底部占位 */
.scroll-bottom {
  height: 20rpx;
}

/* 底部输入区域 */
.chat-input-area {
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(15, 15, 26, 0.98);
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.input-wrapper {
  display: flex;
  align-items: flex-end;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
}

.chat-input {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
  min-height: 48rpx;
  max-height: 160rpx;
  line-height: 1.5;
  padding: 8rpx 0;
}

.input-placeholder {
  color: #666;
}

.btn-send {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  font-size: 36rpx;
  color: #666;
  flex-shrink: 0;
}

.btn-send.active {
  background: linear-gradient(135deg, #00d4ff 0%, #7b2cbf 100%);
  color: #fff;
}

.input-hint {
  text-align: center;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #666;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}