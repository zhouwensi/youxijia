.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0a0a10;
  color: #fff;
  box-sizing: border-box;
}
.scroll {
  flex: 1;
  height: 0;
  padding: 16rpx 20rpx 0;
  box-sizing: border-box;
}
.scroll-pad {
  height: 280rpx;
}
.welcome {
  padding: 8rpx 8rpx 24rpx;
}
.h1 {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.45;
  display: block;
  margin-bottom: 12rpx;
}
.h2 {
  font-size: 24rpx;
  color: #9aa3b8;
  display: block;
  margin-bottom: 20rpx;
}
.role-row {
  background: #141422;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  border: 1px solid #26263a;
}
.role-label {
  font-size: 24rpx;
  color: #aeb6ca;
  display: block;
  margin-bottom: 12rpx;
}
.role-group {
  display: flex;
  gap: 32rpx;
  flex-wrap: wrap;
}
.role-opt {
  font-size: 26rpx;
  color: #e8ecff;
}
.card {
  background: #12121c;
  border: 1px solid #252538;
  border-radius: 18rpx;
  padding: 22rpx;
  margin-bottom: 20rpx;
}
.card-head {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.emoji {
  font-size: 44rpx;
  line-height: 1;
}
.card-titles {
  flex: 1;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}
.card-sub {
  font-size: 22rpx;
  color: #8f96ab;
  line-height: 1.4;
  display: block;
}
.btn-row {
  display: flex;
  gap: 16rpx;
}
.btn {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.3;
  padding: 18rpx 8rpx;
  border-radius: 12rpx;
  border: none;
}
.btn.main {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
}
.btn.sub {
  background: #1e2436;
  color: #c5d0f2;
  border: 1px solid #343a52;
}
.btn.disabled {
  opacity: 0.45;
}
.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12rpx 16rpx calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(8, 8, 14, 0.96);
  border-top: 1px solid #222336;
  z-index: 50;
}
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}
.dialog {
  width: 100%;
  max-width: 620rpx;
  background: #161622;
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1px solid #2f2f44;
}
.dlg-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  text-align: center;
  margin-bottom: 16rpx;
}
.dlg-code {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-align: center;
  display: block;
  margin-bottom: 16rpx;
  color: #7cf7c4;
}
.copy-btn {
  margin: 0 auto 16rpx;
  display: block;
}
.dlg-hint {
  font-size: 22rpx;
  color: #9aa3b8;
  text-align: center;
  display: block;
  margin-bottom: 20rpx;
  line-height: 1.5;
}
.dlg-close {
  background: #2a2a3d;
  color: #fff;
  font-size: 28rpx;
}
