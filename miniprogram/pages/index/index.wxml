<!--
  首页 - 游戏列表
-->
<view class="page-container">
  <!-- 顶部标题栏 -->
  <view class="header">
    <view class="header-left">
      <text class="logo-icon">🎮</text>
      <text class="logo-text">{{appName}}</text>
    </view>
    <view class="header-right">
      <view class="search-btn" bindtap="goToSearch">
        <text class="search-icon">🔍</text>
      </view>
    </view>
  </view>

  <!-- Tab切换 -->
  <view class="tabs">
    <view 
      class="tab-item {{currentTab === index ? 'active' : ''}}" 
      wx:for="{{tabs}}" 
      wx:key="id"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <text>{{item.name}}</text>
      <view class="tab-indicator" wx:if="{{currentTab === index}}"></view>
    </view>
  </view>

  <!-- 游戏列表 -->
  <scroll-view 
    class="game-list"
    scroll-y
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onPullDownRefresh"
    bindscrolltolower="onReachBottom"
  >
    <!-- 游戏卡片 -->
    <view 
      class="game-card" 
      wx:for="{{games}}" 
      wx:key="id"
      data-game="{{item}}"
      bindtap="goToGameDetail"
    >
      <!-- 游戏封面/图标 -->
      <view class="game-cover">
        <text class="game-emoji">🎮</text>
      </view>
      
      <!-- 游戏信息 -->
      <view class="game-info">
        <view class="game-title ellipsis">{{item.title || '未命名游戏'}}</view>
        <view class="game-prompt ellipsis-2">{{item.prompt || '暂无描述'}}</view>
        <view class="game-meta">
          <view class="meta-item">
            <text class="meta-icon">👤</text>
            <text>{{item.author_name || '匿名'}}</text>
          </view>
          <view class="meta-item">
            <text class="meta-icon">❤️</text>
            <text>{{item.likes || 0}}</text>
          </view>
          <view class="meta-item">
            <text class="meta-icon">👁️</text>
            <text>{{item.plays || 0}}</text>
          </view>
        </view>
      </view>
      
      <!-- 箭头 -->
      <view class="game-arrow">
        <text>›</text>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="loading-more" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && games.length > 0}}">
      <text>— 已经到底啦 —</text>
    </view>

    <!-- 空状态 -->
    <view class="empty" wx:if="{{!loading && games.length === 0}}">
      <text class="empty-icon">🎮</text>
      <text class="empty-text">暂无游戏</text>
      <text class="empty-tip">去网页创作你的第一个游戏吧！</text>
    </view>
  </scroll-view>

  <!-- 底部创作按钮 -->
  <view class="create-btn-wrapper safe-area-bottom">
    <view class="create-btn" bindtap="goToCreate">
      <text class="create-icon">✨</text>
      <text class="create-text">去网页创作游戏</text>
    </view>
  </view>
</view>
