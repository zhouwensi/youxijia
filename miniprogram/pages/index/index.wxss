/**
 * 首页样式
 */

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--bg-color);
}

/* 顶部标题栏 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: var(--bg-card);
  border-bottom: 1rpx solid var(--border-color);
}

.header-left {
  display: flex;
  align-items: center;
}

.logo-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.logo-text {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.header-right {
  display: flex;
  align-items: center;
}

.search-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--bg-color);
  border-radius: 50%;
}

.search-icon {
  font-size: 36rpx;
}

/* Tab切换 */
.tabs {
  display: flex;
  background-color: var(--bg-card);
  padding: 0 20rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.tab-item {
  position: relative;
  padding: 24rpx 40rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  transition: color 0.3s;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
  border-radius: 3rpx;
}

/* 游戏列表 */
.game-list {
  flex: 1;
  padding: 20rpx;
  padding-bottom: 160rpx;
}

/* 游戏卡片 */
.game-card {
  display: flex;
  align-items: center;
  background-color: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border-color);
  transition: all 0.3s ease;
}

.game-card:active {
  background-color: var(--bg-card-hover);
  transform: scale(0.98);
}

.game-cover {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #1a1a2e, #2d2d4a);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.game-emoji {
  font-size: 56rpx;
}

.game-info {
  flex: 1;
  min-width: 0;
}

.game-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 8rpx;
}

.game-prompt {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.game-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-muted);
}

.meta-icon {
  margin-right: 6rpx;
  font-size: 20rpx;
}

.game-arrow {
  font-size: 40rpx;
  color: var(--text-muted);
  margin-left: 16rpx;
}

/* 加载更多 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
}

.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 16rpx;
}

.loading-text {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 30rpx;
  color: var(--text-muted);
  font-size: 24rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 底部创作按钮 */
.create-btn-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: linear-gradient(to top, var(--bg-color) 60%, transparent);
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.create-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  color: #000000;
  padding: 28rpx 40rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 30rpx rgba(0, 212, 255, 0.3);
}

.create-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.create-icon {
  margin-right: 12rpx;
  font-size: 36rpx;
}

.create-text {
  font-weight: 600;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
