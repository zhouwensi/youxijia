/* pages/llm-settings/llm-settings.wxss */
/* 参考网站样式实现 */

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f0f1a 0%, #1a1a2e 100%);
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  gap: 24rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(0, 212, 255, 0.2);
  border-top-color: #00d4ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 滚动区域 */
.settings-scroll {
  height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 页面头部 */
.page-header {
  margin-bottom: 40rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.page-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 分区 */
.section {
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.section-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 24rpx;
  line-height: 1.5;
}

/* 开关 */
.section-toggle {
  width: 88rpx;
  height: 48rpx;
}

.toggle-track {
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  position: relative;
  transition: background 0.2s;
}

.section-toggle.on .toggle-track {
  background: linear-gradient(135deg, #00d4ff, #00a0cc);
}

.toggle-thumb {
  width: 40rpx;
  height: 40rpx;
  background: #fff;
  border-radius: 50%;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: left 0.2s;
}

.section-toggle.on .toggle-thumb {
  left: 44rpx;
}

/* 模型列表 */
.model-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.model-item {
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 24rpx;
  transition: all 0.2s;
}

.model-item.selected {
  border-color: rgba(99, 102, 241, 0.5);
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(139, 92, 246, 0.08));
}

.model-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

/* 单选按钮 */
.model-radio {
  flex-shrink: 0;
}

.radio-outer {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.model-item.selected .radio-outer {
  border-color: #6366f1;
}

.radio-inner {
  width: 22rpx;
  height: 22rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  border-radius: 50%;
}

.model-info {
  flex: 1;
}

.model-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 6rpx;
}

.model-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.model-badge.need-key {
  background: rgba(245, 158, 11, 0.2);
  color: #f59e0b;
}

.model-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* API Key 输入 */
.model-key-input {
  margin-top: 16rpx;
}

.key-input-wrapper {
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  overflow: hidden;
}

.key-input {
  flex: 1;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #fff;
}

.key-input::placeholder {
  color: rgba(255, 255, 255, 0.3);
}

.key-toggle {
  padding: 20rpx;
  font-size: 28rpx;
}

/* 自定义接口表单 */
.custom-api-form {
  margin-top: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: rgba(0, 0, 0, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #fff;
  box-sizing: border-box;
}

.form-input::placeholder {
  color: rgba(255, 255, 255, 0.3);
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}

.btn {
  flex: 1;
  padding: 28rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}

.btn::after {
  border: none;
}

.btn-reset {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.7);
}

.btn-save {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
}

.btn-save.disabled {
  opacity: 0.6;
}

/* 设置分组 */
.settings-group {
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.group-header {
  margin-bottom: 16rpx;
}

.group-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.group-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 24rpx;
  line-height: 1.6;
}

/* 模型列表 - 网站样式 */
.llm-keys-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.llm-key-item {
  background: rgba(255, 255, 255, 0.02);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 24rpx;
  transition: all 0.25s ease;
}

.llm-key-item.is-default {
  border-color: rgba(99, 102, 241, 0.5);
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.12), rgba(139, 92, 246, 0.08));
  box-shadow: 0 4rpx 20rpx rgba(99, 102, 241, 0.15);
}

/* 模型头部 */
.llm-key-header {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

/* 默认选择框 */
.llm-default-check {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.custom-radio {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.custom-radio.checked {
  border-color: #6366f1;
  background: rgba(99, 102, 241, 0.1);
}

.radio-dot {
  width: 20rpx;
  height: 20rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  border-radius: 50%;
}

.llm-default-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

.llm-key-item.is-default .llm-default-label {
  color: #6366f1;
  font-weight: 500;
}

/* 模型信息 */
.llm-key-info {
  flex: 1;
}

.llm-key-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

/* 模型标签 */
.llm-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.llm-badge.has-key {
  background: rgba(34, 197, 94, 0.15);
  color: #22c55e;
  border: 1rpx solid rgba(34, 197, 94, 0.3);
}

.llm-badge.need-key {
  background: rgba(245, 158, 11, 0.15);
  color: #f59e0b;
  border: 1rpx solid rgba(245, 158, 11, 0.3);
}

/* 状态标签 */
.llm-key-status {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}

.llm-key-status.configured {
  color: #22c55e;
}

/* API Key 输入区 */
.llm-key-input {
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  overflow: hidden;
}

.llm-key-input .key-input {
  flex: 1;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #fff;
  background: transparent;
}

.btn-toggle-pwd {
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
}

.btn-toggle-pwd:active {
  opacity: 0.7;
}

/* 自定义接口表单 - 网站样式 */
.form-group {
  margin-bottom: 24rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.input-with-toggle {
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  overflow: hidden;
}

.input-with-toggle .form-input {
  flex: 1;
  border: none;
  background: transparent;
}

/* 底部操作按钮 - 网站样式 */
.settings-footer {
  display: flex;
  gap: 24rpx;
  padding: 40rpx 0;
  margin-top: 20rpx;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.btn-secondary:active {
  background: rgba(255, 255, 255, 0.12);
}

.btn-primary {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.3);
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-primary.disabled {
  opacity: 0.6;
  box-shadow: none;
}

/* 底部安全区 */
.safe-area-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
