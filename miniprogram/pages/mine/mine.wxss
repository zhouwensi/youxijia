.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0a0a10;
  color: #fff;
}
.scroll {
  flex: 1;
  height: 0;
  padding: 16rpx 20rpx 0;
  box-sizing: border-box;
}
.user-card {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #12121c;
  border-radius: 16rpx;
  border: 1px solid #252538;
  margin-bottom: 20rpx;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #2a2a3d;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.img {
  width: 100%;
  height: 100%;
}
.ph {
  font-size: 22rpx;
  color: #8b90a4;
}
.meta {
  flex: 1;
}
.nick {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}
.sub {
  font-size: 22rpx;
  color: #8f96ab;
  line-height: 1.4;
  display: block;
}
.section {
  background: #12121c;
  border: 1px solid #252538;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.sec-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.sec-title {
  font-size: 28rpx;
  font-weight: 600;
}
.filters {
  display: flex;
  gap: 12rpx;
}
.pick {
  font-size: 22rpx;
  color: #7cf7c4;
  padding: 8rpx 12rpx;
  border: 1px solid #2f3f3a;
  border-radius: 10rpx;
}
.empty {
  font-size: 24rpx;
  color: #7a8199;
  padding: 24rpx 0;
  text-align: center;
}
.row {
  padding: 16rpx 0;
  border-bottom: 1px solid #222336;
}
.row.dim {
  opacity: 0.45;
}
.row-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.k {
  font-size: 24rpx;
  color: #c5cef7;
}
.s {
  font-size: 22rpx;
  color: #9aa3b8;
}
.code {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 8rpx;
}
.row-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 22rpx;
  color: #8f96ab;
  margin-bottom: 8rpx;
}
.mini-copy {
  align-self: flex-start;
}
.menu {
  padding: 20rpx 0;
  border-bottom: 1px solid #222336;
  color: #5ed0ff;
  font-size: 26rpx;
}
.help {
  font-size: 26rpx;
  color: #c8cdda;
  line-height: 1.55;
  display: block;
  padding-top: 8rpx;
}
.pad {
  height: 200rpx;
}
.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 8rpx 12rpx calc(8rpx + env(safe-area-inset-bottom));
  background: rgba(8, 8, 14, 0.96);
  border-top: 1px solid #222336;
  z-index: 40;
}
