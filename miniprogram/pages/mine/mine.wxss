/**
 * 我的页面样式
 */

.page-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding: 20rpx;
  padding-bottom: 180rpx;
}

/* 用户卡片 */
.user-card {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border-color);
}

/* 未登录状态 */
.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.avatar-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2d2d4a, #1a1a2e);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 24rpx;
  border: 3rpx solid var(--border-color);
}

.login-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.login-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 8rpx;
}

.login-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.login-btn {
  width: 280rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}

/* 已登录状态 */
.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.user-details {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 8rpx;
}

.account-id {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.share-btn {
  width: 72rpx;
  height: 72rpx;
  background-color: var(--bg-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background-color: var(--bg-card);
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border-color);
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stats-value {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: var(--border-color);
}

/* 菜单卡片 */
.menu-card {
  background-color: var(--bg-card);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--border-color);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border-color);
  transition: background-color 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: var(--bg-card-hover);
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-name {
  font-size: 30rpx;
  color: var(--text-color);
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-badge {
  background-color: var(--primary-color);
  color: #000;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
}

.menu-tip {
  font-size: 24rpx;
  color: var(--primary-color);
  margin-right: 16rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--text-muted);
}

/* 底部提示 */
.footer-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 20rpx;
  color: var(--text-muted);
  font-size: 24rpx;
}

.website {
  color: var(--primary-color);
  margin-top: 8rpx;
}

/* 底部创作按钮 */
.create-btn-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: linear-gradient(to top, var(--bg-color) 60%, transparent);
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.create-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  color: #000000;
  padding: 28rpx 40rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 30rpx rgba(0, 212, 255, 0.3);
}

.create-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.create-icon {
  margin-right: 12rpx;
  font-size: 36rpx;
}

.create-text {
  font-weight: 600;
}
