<!--
  排行榜页面
-->
<view class="page-container">
  <!-- 顶部标题 -->
  <view class="header">
    <text class="header-title">🏆 排行榜</text>
  </view>

  <!-- 主分类切换：游戏榜/作者榜 -->
  <view class="category-tabs">
    <view 
      class="category-tab {{currentCategory === item.id ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="id"
      data-category="{{item.id}}"
      bindtap="switchCategory"
    >
      <text>{{item.name}}</text>
    </view>
  </view>

  <!-- 时间维度切换 -->
  <view class="period-tabs">
    <view 
      class="period-tab {{currentPeriod === item.id ? 'active' : ''}}"
      wx:for="{{periods}}"
      wx:key="id"
      data-period="{{item.id}}"
      bindtap="switchPeriod"
    >
      <text>{{item.name}}</text>
    </view>
  </view>

  <!-- 排行榜列表 -->
  <scroll-view 
    class="rank-list"
    scroll-y
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onPullDownRefresh"
    bindscrolltolower="onReachBottom"
  >
    <!-- 游戏榜列表 -->
    <block wx:if="{{currentCategory === 'games'}}">
      <view 
        class="rank-item game-item"
        wx:for="{{rankList}}"
        wx:key="id"
        data-game="{{item}}"
        bindtap="goToGameDetail"
      >
        <!-- 排名 -->
        <view class="rank-number {{index < 3 ? 'top-' + (index + 1) : ''}}">
          <text wx:if="{{index === 0}}">🥇</text>
          <text wx:elif="{{index === 1}}">🥈</text>
          <text wx:elif="{{index === 2}}">🥉</text>
          <text wx:else>{{index + 1}}</text>
        </view>
        
        <!-- 游戏封面 -->
        <view class="game-cover">
          <text class="game-emoji">🎮</text>
        </view>
        
        <!-- 游戏信息 -->
        <view class="game-info">
          <view class="game-title ellipsis">{{item.title || '未命名游戏'}}</view>
          <view class="game-author">
            <text class="author-icon">👤</text>
            <text>{{item.author_name || '匿名'}}</text>
          </view>
        </view>
        
        <!-- 数据统计 -->
        <view class="game-stats">
          <view class="stat-item">
            <text class="stat-icon">❤️</text>
            <text class="stat-value">{{item.likes || 0}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-icon">👁️</text>
            <text class="stat-value">{{item.plays || 0}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 作者榜列表 -->
    <block wx:if="{{currentCategory === 'authors'}}">
      <view 
        class="rank-item author-item"
        wx:for="{{rankList}}"
        wx:key="token"
        data-user="{{item}}"
        bindtap="goToUserProfile"
      >
        <!-- 排名 -->
        <view class="rank-number {{index < 3 ? 'top-' + (index + 1) : ''}}">
          <text wx:if="{{index === 0}}">🥇</text>
          <text wx:elif="{{index === 1}}">🥈</text>
          <text wx:elif="{{index === 2}}">🥉</text>
          <text wx:else>{{index + 1}}</text>
        </view>
        
        <!-- 作者头像 -->
        <view class="author-avatar">
          <text>{{item.avatar_emoji || '🎮'}}</text>
        </view>
        
        <!-- 作者信息 -->
        <view class="author-info">
          <view class="author-name ellipsis">{{item.nickname || '游戏家用户'}}</view>
          <view class="author-meta">
            <text class="meta-item">🎮 {{item.games_count || 0}} 作品</text>
            <text class="meta-item">👥 {{item.followers_count || 0}} 粉丝</text>
          </view>
        </view>
        
        <!-- 热度值 -->
        <view class="author-heat">
          <text class="heat-icon">🔥</text>
          <text class="heat-value">{{item.heat || 0}}</text>
        </view>
      </view>
    </block>

    <!-- 加载状态 -->
    <view class="loading-more" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && rankList.length > 0}}">
      <text>— 已经到底啦 —</text>
    </view>

    <!-- 空状态 -->
    <view class="empty" wx:if="{{!loading && rankList.length === 0}}">
      <text class="empty-icon">🏆</text>
      <text class="empty-text">暂无排行数据</text>
    </view>
  </scroll-view>
</view>
