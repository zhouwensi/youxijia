/**
 * 排行榜页面样式
 */

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f0f1a 0%, #1a1a2e 100%);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 顶部标题 */
.header {
  padding: 40rpx 32rpx 24rpx;
  background: rgba(0, 0, 0, 0.3);
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

/* 主分类切换 */
.category-tabs {
  display: flex;
  padding: 24rpx 32rpx;
  gap: 24rpx;
}

.category-tab {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  color: #8b8b8b;
  font-size: 30rpx;
  transition: all 0.3s;
}

.category-tab.active {
  background: linear-gradient(135deg, #00d4ff 0%, #7b2cbf 100%);
  color: #fff;
  font-weight: bold;
}

/* 时间维度切换 */
.period-tabs {
  display: flex;
  padding: 0 32rpx 24rpx;
  gap: 16rpx;
}

.period-tab {
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  color: #8b8b8b;
  font-size: 26rpx;
  transition: all 0.3s;
}

.period-tab.active {
  background: rgba(0, 212, 255, 0.2);
  color: #00d4ff;
  border: 1rpx solid rgba(0, 212, 255, 0.5);
}

/* 排行榜列表 */
.rank-list {
  height: calc(100vh - 280rpx);
  padding: 0 32rpx;
}

/* 排行项 */
.rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  transition: transform 0.2s;
}

.rank-item:active {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.08);
}

/* 排名 */
.rank-number {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #8b8b8b;
  margin-right: 16rpx;
}

.rank-number.top-1,
.rank-number.top-2,
.rank-number.top-3 {
  font-size: 40rpx;
}

/* 游戏封面 */
.game-cover {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #2a2a4e 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.game-emoji {
  font-size: 40rpx;
}

/* 游戏信息 */
.game-info {
  flex: 1;
  min-width: 0;
}

.game-title {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.game-author {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #8b8b8b;
}

.author-icon {
  margin-right: 8rpx;
}

/* 游戏数据 */
.game-stats {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #8b8b8b;
}

.stat-icon {
  margin-right: 6rpx;
  font-size: 20rpx;
}

.stat-value {
  min-width: 60rpx;
  text-align: right;
}

/* 作者头像 */
.author-avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #7b2cbf 0%, #00d4ff 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 36rpx;
}

/* 作者信息 */
.author-info {
  flex: 1;
  min-width: 0;
}

.author-name {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.author-meta {
  display: flex;
  gap: 16rpx;
  font-size: 22rpx;
  color: #8b8b8b;
}

/* 热度值 */
.author-heat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
  background: rgba(255, 100, 50, 0.15);
  border-radius: 12rpx;
}

.heat-icon {
  font-size: 24rpx;
}

.heat-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6432;
}

/* 文本省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 加载状态 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  gap: 16rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(0, 212, 255, 0.3);
  border-top-color: #00d4ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #8b8b8b;
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: #666;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 32rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8b8b8b;
}
