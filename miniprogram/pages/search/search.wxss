/**
 * 搜索页面样式
 */

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f0f1a 0%, #1a1a2e 100%);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 搜索框 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: rgba(0, 0, 0, 0.3);
  gap: 16rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 36rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
}

.search-input::placeholder {
  color: #666;
}

.clear-icon {
  font-size: 36rpx;
  color: #666;
  padding: 8rpx;
}

.search-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #00d4ff 0%, #7b2cbf 100%);
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #fff;
}

/* 类型切换 */
.type-tabs {
  display: flex;
  padding: 24rpx 32rpx;
  gap: 24rpx;
}

.type-tab {
  padding: 16rpx 32rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #8b8b8b;
}

.type-tab.active {
  background: rgba(0, 212, 255, 0.2);
  color: #00d4ff;
}

/* 结果列表 */
.result-list {
  height: calc(100vh - 200rpx);
  padding: 0 32rpx;
}

.result-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
}

.result-item:active {
  background: rgba(255, 255, 255, 0.08);
}

/* 游戏结果 */
.game-cover {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #2a2a4e 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.game-emoji {
  font-size: 40rpx;
}

.game-info {
  flex: 1;
  min-width: 0;
}

.game-title {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.game-author {
  font-size: 24rpx;
  color: #8b8b8b;
  margin-bottom: 8rpx;
}

.game-stats {
  display: flex;
  gap: 16rpx;
  font-size: 22rpx;
  color: #666;
}

/* 用户结果 */
.user-avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #7b2cbf 0%, #00d4ff 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 36rpx;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.user-stats {
  display: flex;
  gap: 16rpx;
  font-size: 22rpx;
  color: #8b8b8b;
}

/* 文本省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 加载状态 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  gap: 16rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(0, 212, 255, 0.3);
  border-top-color: #00d4ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #8b8b8b;
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: #666;
}

/* 空状态 */
.empty,
.default-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 32rpx;
}

.empty-icon,
.default-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text,
.default-text {
  font-size: 28rpx;
  color: #8b8b8b;
}
