/**
 * 用户主页样式
 */

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f0f1a 0%, #1a1a2e 100%);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 用户信息卡片 */
.user-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  background: rgba(255, 255, 255, 0.03);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.user-avatar {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #7b2cbf 0%, #00d4ff 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-bottom: 24rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: #8b8b8b;
  margin-bottom: 16rpx;
}

.user-bio {
  font-size: 28rpx;
  color: #aaa;
  text-align: center;
  margin-bottom: 24rpx;
  padding: 0 32rpx;
}

/* 统计数据 */
.user-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.stat-label {
  font-size: 24rpx;
  color: #8b8b8b;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.1);
}

/* 关注按钮 */
.action-area {
  width: 100%;
  padding: 0 64rpx;
}

.follow-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  background: linear-gradient(135deg, #00d4ff 0%, #7b2cbf 100%);
  border-radius: 40rpx;
  border: none;
}

.follow-btn.following {
  background: rgba(255, 255, 255, 0.1);
  color: #8b8b8b;
}

.follow-btn::after {
  border: none;
}

/* 作品列表区域 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.section-count {
  font-size: 26rpx;
  color: #8b8b8b;
}

.games-list {
  height: calc(100vh - 520rpx);
  padding: 0 32rpx;
}

/* 游戏卡片 */
.game-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  transition: transform 0.2s;
}

.game-card:active {
  transform: scale(0.98);
}

.game-cover {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #2a2a4e 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.game-emoji {
  font-size: 40rpx;
}

.game-info {
  flex: 1;
  min-width: 0;
}

.game-title {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.game-desc {
  font-size: 24rpx;
  color: #8b8b8b;
  margin-bottom: 8rpx;
}

.game-meta {
  display: flex;
  gap: 16rpx;
  font-size: 22rpx;
  color: #666;
}

.game-arrow {
  font-size: 40rpx;
  color: #666;
  margin-left: 16rpx;
}

/* 文本省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 加载状态 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  gap: 16rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(0, 212, 255, 0.3);
  border-top-color: #00d4ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #8b8b8b;
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: #666;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8b8b8b;
}
