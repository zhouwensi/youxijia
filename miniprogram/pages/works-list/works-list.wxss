/* pages/works-list/works-list.wxss */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f0f1a 0%, #1a1a2e 100%);
}

.games-scroll {
  height: 100vh;
}

/* 游戏网格 - 2列 */
.games-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding: 24rpx;
}

.game-card {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  overflow: hidden;
  transition: all 0.2s;
}

.game-card:active {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.1);
}

.game-cover {
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(139, 92, 246, 0.2));
}

.game-emoji {
  font-size: 72rpx;
}

.game-info {
  padding: 20rpx;
}

.game-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  display: block;
  margin-bottom: 12rpx;
}

.game-meta {
  margin-bottom: 12rpx;
}

.meta-author {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.game-stats {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.stat-item {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 加载中 */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  gap: 20rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(0, 212, 255, 0.2);
  border-top-color: #00d4ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: rgba(255, 255, 255, 0.3);
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 20rpx;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* 通用 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 底部安全区 */
.safe-area-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
