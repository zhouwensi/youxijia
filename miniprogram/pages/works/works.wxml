<!--pages/works/works.wxml-->
<view class="page-container">
  <!-- 顶部标题栏 -->
  <view class="header">
    <view class="header-left">
      <text class="logo-icon">🎮</text>
      <text class="logo-text">AI游戏工坊</text>
    </view>
    <view class="header-right">
      <view class="search-btn" bindtap="goToSearch">
        <text class="search-icon">🔍</text>
      </view>
    </view>
  </view>

  <!-- 内容区域 -->
  <scroll-view class="main-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 各分类区块 -->
    <view class="section" wx:for="{{sections}}" wx:key="id">
      <view class="section-header">
        <text class="section-title">{{item.title}}</text>
        <view class="section-more" bindtap="viewMore" data-id="{{item.id}}" data-title="{{item.title}}">
          <text>更多</text>
          <text class="arrow">→</text>
        </view>
      </view>
      
      <!-- 加载中 -->
      <view class="loading-box" wx:if="{{item.loading}}">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>
      
      <!-- 游戏网格 -->
      <view class="games-grid" wx:elif="{{item.games.length > 0}}">
        <view 
          class="game-card" 
          wx:for="{{item.games}}" 
          wx:for-item="game" 
          wx:key="id"
          bindtap="goToGameDetail"
          data-game="{{game}}"
        >
          <view class="game-cover">
            <text class="game-emoji">{{game.emoji || '🎮'}}</text>
          </view>
          <view class="game-info">
            <text class="game-title ellipsis">{{game.title || '未命名'}}</text>
            <view class="game-meta">
              <text class="meta-item">👤 {{game.author_name || '匿名'}}</text>
            </view>
            <view class="game-stats">
              <text class="stat-item">❤️ {{game.likes || 0}}</text>
              <text class="stat-item">👁️ {{game.plays || 0}}</text>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 空状态 -->
      <view class="empty-box" wx:else>
        <text class="empty-text">暂无游戏</text>
      </view>
    </view>

    <!-- 底部安全区 -->
    <view class="safe-area-bottom"></view>
  </scroll-view>
</view>
