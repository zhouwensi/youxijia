/* pages/works/works.wxss */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f0f1a 0%, #1a1a2e 100%);
  display: flex;
  flex-direction: column;
}

/* 顶部标题栏 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  background: rgba(15, 15, 26, 0.95);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.logo-icon {
  font-size: 48rpx;
}

.logo-text {
  font-size: 36rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #00d4ff, #7b68ee);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.search-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
}

.search-icon {
  font-size: 36rpx;
}

/* 主滚动区域 */
.main-scroll {
  flex: 1;
  height: calc(100vh - 160rpx - env(safe-area-inset-top));
}

/* 分类区块 */
.section {
  padding: 30rpx;
  padding-bottom: 10rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.section-more {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

.section-more .arrow {
  color: #00d4ff;
}

/* 游戏网格 - 3列 */
.games-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.game-card {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  overflow: hidden;
  transition: all 0.2s;
}

.game-card:active {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.1);
}

.game-cover {
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(139, 92, 246, 0.2));
}

.game-emoji {
  font-size: 56rpx;
}

.game-info {
  padding: 16rpx;
}

.game-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.game-meta {
  margin-bottom: 8rpx;
}

.meta-item {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

.game-stats {
  display: flex;
  gap: 16rpx;
}

.stat-item {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* 加载中 */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  gap: 20rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(0, 212, 255, 0.2);
  border-top-color: #00d4ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 空状态 */
.empty-box {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* 通用 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 底部安全区 */
.safe-area-bottom {
  height: calc(120rpx + env(safe-area-inset-bottom));
}
