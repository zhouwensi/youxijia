<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GitHub Pages 网速测试</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #fff;
        }
        .container {
            text-align: center;
            padding: 40px;
            background: rgba(255,255,255,0.1);
            border-radius: 20px;
            backdrop-filter: blur(10px);
            max-width: 500px;
            width: 90%;
        }
        h1 { margin-bottom: 10px; font-size: 28px; }
        .subtitle { color: #888; margin-bottom: 30px; }
        .speed-display {
            font-size: 64px;
            font-weight: bold;
            color: #00d4ff;
            margin: 20px 0;
        }
        .unit { font-size: 24px; color: #888; }
        .btn {
            background: linear-gradient(135deg, #00d4ff, #0099cc);
            border: none;
            padding: 15px 50px;
            font-size: 18px;
            color: #fff;
            border-radius: 30px;
            cursor: pointer;
            margin: 20px 0;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn:hover { transform: scale(1.05); box-shadow: 0 10px 30px rgba(0,212,255,0.3); }
        .btn:disabled { background: #555; cursor: not-allowed; transform: none; }
        .progress {
            width: 100%;
            height: 8px;
            background: rgba(255,255,255,0.2);
            border-radius: 4px;
            margin: 20px 0;
            overflow: hidden;
        }
        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, #00d4ff, #00ff88);
            width: 0%;
            transition: width 0.3s;
        }
        .results {
            margin-top: 20px;
            text-align: left;
            background: rgba(0,0,0,0.3);
            padding: 20px;
            border-radius: 10px;
        }
        .result-item {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .result-item:last-child { border-bottom: none; }
        .label { color: #888; }
        .value { color: #00d4ff; font-weight: bold; }
        .status { color: #888; margin: 10px 0; }
    </style>
</head>
<body>
    <div class="container">
        <h1>⚡ 网速测试</h1>
        <p class="subtitle">GitHub Pages 访问速度测试</p>
        
        <div class="speed-display">
            <span id="speed">0</span>
            <span class="unit">Mbps</span>
        </div>
        
        <div class="progress">
            <div class="progress-bar" id="progressBar"></div>
        </div>
        
        <p class="status" id="status">点击按钮开始测试</p>
        
        <button class="btn" id="startBtn" onclick="startTest()">开始测试</button>
        
        <div class="results" id="results" style="display: none;">
            <div class="result-item">
                <span class="label">下载速度</span>
                <span class="value" id="downloadSpeed">-</span>
            </div>
            <div class="result-item">
                <span class="label">延迟 (Ping)</span>
                <span class="value" id="ping">-</span>
            </div>
            <div class="result-item">
                <span class="label">测试文件大小</span>
                <span class="value" id="fileSize">-</span>
            </div>
            <div class="result-item">
                <span class="label">下载耗时</span>
                <span class="value" id="duration">-</span>
            </div>
            <div class="result-item">
                <span class="label">测试时间</span>
                <span class="value" id="testTime">-</span>
            </div>
        </div>
    </div>

    <script>
        // 测试用的公共文件 URL（不同大小）
        const testFiles = [
            { url: 'https://www.google.com/images/branding/googlelogo/2x/googlelogo_color_272x92dp.png', size: 13504 },
            { url: 'https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js', size: 89501 },
            { url: 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css', size: 227136 }
        ];

        async function startTest() {
            const btn = document.getElementById('startBtn');
            const status = document.getElementById('status');
            const speedDisplay = document.getElementById('speed');
            const progressBar = document.getElementById('progressBar');
            const results = document.getElementById('results');

            btn.disabled = true;
            btn.textContent = '测试中...';
            results.style.display = 'none';
            progressBar.style.width = '0%';
            speedDisplay.textContent = '0';

            try {
                // 测试延迟
                status.textContent = '测试延迟中...';
                progressBar.style.width = '20%';
                const ping = await testPing();
                document.getElementById('ping').textContent = ping + ' ms';

                // 测试下载速度
                status.textContent = '测试下载速度...';
                progressBar.style.width = '50%';
                
                const { speed, duration, size } = await testDownload();
                
                // 动画显示速度
                await animateSpeed(speedDisplay, speed);
                
                progressBar.style.width = '100%';
                status.textContent = '测试完成！';

                // 显示结果
                document.getElementById('downloadSpeed').textContent = speed.toFixed(2) + ' Mbps';
                document.getElementById('fileSize').textContent = (size / 1024).toFixed(2) + ' KB';
                document.getElementById('duration').textContent = duration.toFixed(0) + ' ms';
                document.getElementById('testTime').textContent = new Date().toLocaleString();
                results.style.display = 'block';

            } catch (error) {
                status.textContent = '测试失败: ' + error.message;
                speedDisplay.textContent = '-';
            }

            btn.disabled = false;
            btn.textContent = '重新测试';
        }

        async function testPing() {
            const start = performance.now();
            await fetch('https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js', {
                method: 'HEAD',
                cache: 'no-cache'
            });
            return Math.round(performance.now() - start);
        }

        async function testDownload() {
            const testFile = testFiles[2]; // 使用最大的文件
            const startTime = performance.now();
            
            const response = await fetch(testFile.url + '?t=' + Date.now(), {
                cache: 'no-cache'
            });
            const blob = await response.blob();
            
            const endTime = performance.now();
            const duration = endTime - startTime;
            const size = blob.size;
            
            // 计算速度 (Mbps)
            const speedBps = (size * 8) / (duration / 1000);
            const speedMbps = speedBps / 1000000;
            
            return { speed: speedMbps, duration, size };
        }

        async function animateSpeed(element, targetSpeed) {
            const duration = 1000;
            const steps = 30;
            const increment = targetSpeed / steps;
            
            for (let i = 0; i <= steps; i++) {
                element.textContent = (increment * i).toFixed(1);
                await new Promise(r => setTimeout(r, duration / steps));
            }
            element.textContent = targetSpeed.toFixed(1);
        }
    </script>
</body>
</html>
